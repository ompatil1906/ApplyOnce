# Virtualenv (created with `python3 -m venv .venv`)
.venv/
venv/

# Python bytecode
__pycache__/
*.py[cod]

# Scrape output from the CLI scripts (regenerate freely)
data/
*.json
*.csv
!vercel.json

# The local SQLite database, plus the WAL/SHM sidecars SQLite creates alongside
# it. This file holds your research and your send log -- never commit it.
*.db
*.db-wal
*.db-shm

# Secrets — never commit an Apify token
.env
.env.*
!.env.example

# OS noise
.DS_Store